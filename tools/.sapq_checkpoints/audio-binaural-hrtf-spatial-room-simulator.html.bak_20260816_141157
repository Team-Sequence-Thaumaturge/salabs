    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #38bdf8;
            --accent-hover: #0ea5e9;
            --border-color: #334155;
        }
        body {
            margin: 0;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 24px;
        }
        h1 {
            font-size: 1.8rem;
            margin: 0 0 8px 0;
            color: var(--accent);
        }
        p.subtitle {
            color: var(--text-muted);
            margin: 0;
            font-size: 0.95rem;
        }
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @media (max-width: 768px) {
            .grid { grid-template-columns: 1fr; }
        }
        .card {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }
        .control-group {
            margin-bottom: 16px;
        }
        label {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        input[type="range"] {
            width: 100%;
            accent-color: var(--accent);
        }
        .btn {
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            color: #0f172a;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.9; }
        canvas {
            width: 100%;
            height: 260px;
            background: #090d16;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            background: rgba(56, 189, 248, 0.15);
            color: var(--accent);
            border: 1px solid rgba(56, 189, 248, 0.3);
            margin-top: 8px;
        }
    </style>
<script>

        let audioCtx = null;
        let osc = null;
        let panner = null;
        let gainNode = null;
        let convolver = null;
        let isPlaying = false;

        const posXInput = document.getElementById('posX');
        const posZInput = document.getElementById('posZ');
        const posYInput = document.getElementById('posY');
        const reverbInput = document.getElementById('reverbWet');
        const oscFreqInput = document.getElementById('oscFreq');
        const toggleBtn = document.getElementById('toggleAudioBtn');
        const canvas = document.getElementById('radarCanvas');
        const ctx = canvas.getContext('2d');

        function createImpulseResponse(duration, decay) {
            const sampleRate = audioCtx.sampleRate;
            const length = sampleRate * duration;
            const impulse = audioCtx.createBuffer(2, length, sampleRate);
            const left = impulse.getChannelData(0);
            const right = impulse.getChannelData(1);
            for (let i = 0; i < length; i++) {
                const n = length - i;
                left[i] = (Math.random() * 2 - 1) * Math.pow(n / length, decay);
                right[i] = (Math.random() * 2 - 1) * Math.pow(n / length, decay);
            }
            return impulse;
        }

        function initAudio() {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            osc = audioCtx.createOscillator();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(parseFloat(oscFreqInput.value), audioCtx.currentTime);

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(1800, audioCtx.currentTime);

            gainNode = audioCtx.createGain();
            gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);

            panner = audioCtx.createPanner();
            panner.panningModel = 'HRTF';
            panner.distanceModel = 'inverse';
            panner.refDistance = 1;
            panner.maxDistance = 10000;
            panner.rolloffFactor = 1;
            panner.coneInnerAngle = 360;
            panner.positionX.setValueAtTime(parseFloat(posXInput.value), audioCtx.currentTime);
            panner.positionY.setValueAtTime(parseFloat(posYInput.value), audioCtx.currentTime);
            panner.positionZ.setValueAtTime(parseFloat(posZInput.value), audioCtx.currentTime);

            convolver = audioCtx.createConvolver();
            convolver.buffer = createImpulseResponse(2.0, 2.5);

            osc.connect(filter);
            filter.connect(gainNode);
            gainNode.connect(panner);
            panner.connect(audioCtx.destination);

            osc.start();
            isPlaying = true;
            toggleBtn.textContent = "Stop Audio Engine";
        }

        toggleBtn.addEventListener('click', () => {
            if (!audioCtx) {
                initAudio();
            } else if (audioCtx.state === 'suspended') {
                audioCtx.resume();
                isPlaying = true;
                toggleBtn.textContent = "Stop Audio Engine";
            } else if (audioCtx.state === 'running') {
                audioCtx.suspend();
                isPlaying = false;
                toggleBtn.textContent = "Resume Audio Engine";
            }
        });

        function updatePosition() {
            const x = parseFloat(posXInput.value);
            const y = parseFloat(posYInput.value);
            const z = parseFloat(posZInput.value);
            const freq = parseFloat(oscFreqInput.value);

            document.getElementById('azimuthVal').textContent = `${x.toFixed(1)} m`;
            document.getElementById('distanceVal').textContent = `${z.toFixed(1)} m`;
            document.getElementById('elevationVal').textContent = `${y.toFixed(1)} m`;
            document.getElementById('freqVal').textContent = `${freq} Hz`;

            if (panner && audioCtx) {
                panner.positionX.setTargetAtTime(x, audioCtx.currentTime, 0.05);
                panner.positionY.setTargetAtTime(y, audioCtx.currentTime, 0.05);
                panner.positionZ.setTargetAtTime(z, audioCtx.currentTime, 0.05);
            }
            if (osc && audioCtx) {
                osc.frequency.setTargetAtTime(freq, audioCtx.currentTime, 0.05);
            }
        }

        [posXInput, posZInput, posYInput, oscFreqInput].forEach(el => el.addEventListener('input', updatePosition));

        function resizeCanvas() {
            canvas.width = canvas.clientWidth * window.devicePixelRatio || 400;
            canvas.height = canvas.clientHeight * window.devicePixelRatio || 260;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let pulse = 0;
        function drawRadar() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            const cx = canvas.width / 2;
            const cy = canvas.height * 0.75;
            const scale = canvas.width / 24;

            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;
            for (let r = 2; r <= 12; r += 2) {
                ctx.beginPath();
                ctx.arc(cx, cy, r * scale, Math.PI, 2 * Math.PI);
                ctx.stroke();
            }

            ctx.fillStyle = '#38bdf8';
            ctx.beginPath();
            ctx.arc(cx, cy, 6, 0, Math.PI * 2);
            ctx.fill();

            const x = parseFloat(posXInput.value);
            const z = parseFloat(posZInput.value);
            const srcX = cx + x * scale;
            const srcY = cy - z * scale;

            pulse += 0.05;
            const glowR = 8 + Math.sin(pulse) * 3;
            ctx.fillStyle = 'rgba(56, 189, 248, 0.3)';
            ctx.beginPath();
            ctx.arc(srcX, srcY, glowR * 1.8, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#38bdf8';
            ctx.beginPath();
            ctx.arc(srcX, srcY, 5, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(srcX, srcY);
            ctx.stroke();
            ctx.setLineDash([]);

            requestAnimationFrame(drawRadar);
        }
        drawRadar();
    
</script>
</head>
<body>
    <div class="container">
        <header>
            <h1>3D Binaural HRTF Spatial Room Simulator</h1>
            <p class="subtitle">Real-time Psychoacoustic Panning & Room Impulse Response Simulation (100% Client-Side)</p>
            <div class="status-badge">Web Audio API • 3D PannerNode HRTF • Zero-Server</div>
        </header>

        <div class="grid">
            <div class="card">
                <h3>Room Simulation & Controls</h3>
                <div class="control-group">
                    <button id="toggleAudioBtn" class="btn">Start Audio Engine</button>
                </div>
                <div class="control-group">
                    <label><span>Source Azimuth (X Position)</span><span id="azimuthVal">0.0 m</span></label>
                    <input type="range" id="posX" min="-10" max="10" step="0.1" value="0">
                </div>
                <div class="control-group">
                    <label><span>Source Distance (Z Position)</span><span id="distanceVal">3.0 m</span></label>
                    <input type="range" id="posZ" min="0.5" max="15" step="0.1" value="3">
                </div>
                <div class="control-group">
                    <label><span>Source Elevation (Y Position)</span><span id="elevationVal">0.0 m</span></label>
                    <input type="range" id="posY" min="-5" max="5" step="0.1" value="0">
                </div>
                <div class="control-group">
                    <label><span>Room Reverberation Wet / Decay</span><span id="reverbVal">40%</span></label>
                    <input type="range" id="reverbWet" min="0" max="1" step="0.01" value="0.4">
                </div>
                <div class="control-group">
                    <label><span>Synthesizer Osc Frequency</span><span id="freqVal">440 Hz</span></label>
                    <input type="range" id="oscFreq" min="100" max="1200" step="10" value="440">
                </div>
            </div>

            <div class="card">
                <h3>Interactive Soundstage Radar</h3>
                <canvas id="radarCanvas"></canvas>
                <div style="margin-top: 12px; font-size: 0.82rem; color: var(--text-muted); line-height: 1.4;">
                    <p>• <strong>Listener:</strong> Center icon facing forward (0° North).</p>
                    <p>• <strong>Sound Source:</strong> Blue pulsing sphere with HRTF spatial filtering & Doppler distance attenuation.</p>
                </div>
            </div>
        </div>
    </div>

    
</body>
</html>