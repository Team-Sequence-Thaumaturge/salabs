<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>Audio Dynamics Compressor & Limiter Studio - Quanxs SA Labs</title><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Audio Dynamics Compressor & Limiter Studio","url":"https://salabs.quanxs.com/tools/audio-compressor-limiter-studio.html"}</script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9108438313531011" crossorigin="anonymous"></script><style>body{font-family:sans-serif;background:#0f172a;color:#f8fafc;padding:2rem;}.container{max-width:1000px;margin:0 auto;background:#1e293b;padding:2rem;border-radius:12px;text-align:center;}button{background:#38bdf8;color:#0f172a;border:none;padding:0.8rem 1.5rem;border-radius:6px;font-weight:bold;cursor:pointer;}input[type="range"]{width:80%;margin:1rem 0;}</style></head><body><header><h1 style="color:#38bdf8;text-align:center;">Audio Dynamics Compressor & Limiter Studio</h1></header><main class="container"><button onclick="playCompressedTone()">Play Compressed Audio Tone</button><p>Threshold (<span id="thresh-val">-24</span> dB)</p><input type="range" id="thresh-slider" min="-60" max="0" value="-24" oninput="updateCompressor()"></main><script>let audioCtx,osc,compressor;function playCompressedTone(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();if(osc)osc.stop();osc=audioCtx.createOscillator();compressor=audioCtx.createDynamicsCompressor();compressor.threshold.value=parseFloat(document.getElementById('thresh-slider').value);osc.type='sawtooth';osc.frequency.value=330;osc.connect(compressor);compressor.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+1.5);}function updateCompressor(){let v=document.getElementById('thresh-slider').value;document.getElementById('thresh-val').innerText=v;if(compressor)compressor.threshold.value=parseFloat(v);}</script></body></html>