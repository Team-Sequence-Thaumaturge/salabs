<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>Audio BPM Metronome - Quanxs SA Labs</title><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Audio BPM Metronome","url":"https://salabs.quanxs.com/tools/audio-bpm-metronome.html"}</script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9108438313531011" crossorigin="anonymous"></script><style>body{font-family:sans-serif;background:#0f172a;color:#f8fafc;padding:2rem;}.container{max-width:800px;margin:0 auto;background:#1e293b;padding:2rem;border-radius:12px;text-align:center;}.bpm-display{font-size:4rem;font-weight:bold;color:#38bdf8;}button{background:#0284c7;color:#fff;border:none;padding:1rem 2rem;font-size:1.2rem;border-radius:8px;cursor:pointer;margin:0.5rem;}</style></head><body><header><h1 style="color:#38bdf8;text-align:center;">Audio BPM Metronome</h1></header><main class="container"><div class="bpm-display"><span id="bpm-val">120</span> BPM</div><input type="range" id="bpm-slider" min="40" max="240" value="120" oninput="updateBPM(this.value)"><div><button id="toggle-btn" onclick="togglePlay()">Start Metronome</button><button onclick="tapTempo()">Tap Tempo</button></div></main><script>let audioCtx=null,isPlaying=false,bpm=120,timer=null,tapTimes=[];function updateBPM(val){bpm=val;document.getElementById('bpm-val').innerText=bpm;if(isPlaying){clearInterval(timer);timer=setInterval(playClick,(60/bpm)*1000);}}function playClick(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();let osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.frequency.value=1000;gain.gain.setValueAtTime(1,audioCtx.currentTime);gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.05);osc.connect(gain);gain.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+0.05);}function togglePlay(){isPlaying=!isPlaying;let btn=document.getElementById('toggle-btn');if(isPlaying){btn.innerText='Stop Metronome';playClick();timer=setInterval(playClick,(60/bpm)*1000);}else{btn.innerText='Start Metronome';clearInterval(timer);}}function tapTempo(){let now=Date.now();tapTimes.push(now);if(tapTimes.length>4)tapTimes.shift();if(tapTimes.length>1){let diffs=[];for(let i=1;i<tapTimes.length;i++)diffs.push(tapTimes[i]-tapTimes[i-1]);let avg=diffs.reduce((a,b)=>a+b)/diffs.length;let calc=Math.round(60000/avg);if(calc>=40&&calc<=240){document.getElementById('bpm-slider').value=calc;updateBPM(calc);}}}</script></body></html>