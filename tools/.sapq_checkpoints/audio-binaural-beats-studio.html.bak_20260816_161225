<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>Audio Binaural Beats Studio - Quanxs SA Labs</title><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Audio Binaural Beats Studio","url":"https://salabs.quanxs.com/tools/audio-binaural-beats-studio.html"}</script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9108438313531011" crossorigin="anonymous"></script><style>body{font-family:sans-serif;background:#0f172a;color:#f8fafc;padding:2rem;}.container{max-width:1000px;margin:0 auto;background:#1e293b;padding:2rem;border-radius:12px;text-align:center;}button{background:#38bdf8;color:#0f172a;border:none;padding:0.8rem 1.5rem;border-radius:6px;font-weight:bold;cursor:pointer;}input[type="range"]{width:80%;margin:1rem 0;}</style></head><body><header><h1 style="color:#38bdf8;text-align:center;">Audio Binaural Beats Studio</h1></header><main class="container"><button onclick="toggleBeats()" id="btn-play">Start Binaural Beats</button><p>Base Frequency (<span id="base-val">200</span> Hz)</p><input type="range" id="base-f" min="100" max="500" value="200" oninput="updateFreq()"><p>Beat Difference (<span id="diff-val">10</span> Hz)</p><input type="range" id="diff-f" min="1" max="30" value="10" oninput="updateFreq()"></main><script>let audioCtx,oscL,oscR,panL,panR,isPlaying=false;function toggleBeats(){let btn=document.getElementById('btn-play');if(!isPlaying){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();oscL=audioCtx.createOscillator();oscR=audioCtx.createOscillator();panL=audioCtx.createStereoPanner();panR=audioCtx.createStereoPanner();panL.pan.value=-1;panR.pan.value=1;updateFreq();oscL.connect(panL);oscR.connect(panR);panL.connect(audioCtx.destination);panR.connect(audioCtx.destination);oscL.start();oscR.start();isPlaying=true;btn.innerText='Stop Binaural Beats';}else{if(oscL)oscL.stop();if(oscR)oscR.stop();isPlaying=false;btn.innerText='Start Binaural Beats';}}function updateFreq(){let base=parseFloat(document.getElementById('base-f').value);let diff=parseFloat(document.getElementById('diff-f').value);document.getElementById('base-val').innerText=base;document.getElementById('diff-val').innerText=diff;if(isPlaying&&oscL&&oscR){oscL.frequency.value=base;oscR.frequency.value=base+diff;}}</script></body></html>