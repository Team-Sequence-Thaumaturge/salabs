<script>

        let audioCtx = null;
        let isPlaying = false;
        let oscL = null, oscR = null;
        let oscSub1L = null, oscSub1R = null;
        let oscSub2 = null;
        let gainMain = null, gainSub1 = null, gainSub2 = null;
        let shaper = null, masterGain = null, analyser = null;
        let animationId = null;

        function makeDistortionCurve(amount) {
            const k = amount * 10;
            const n_samples = 44100;
            const curve = new Float32Array(n_samples);
            const deg = Math.PI / 180;
            for (let i = 0; i < n_samples; ++i) {
                const x = (i * 2) / n_samples - 1;
                curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
            }
            return curve;
        }

        function initAudio() {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            
            masterGain = audioCtx.createGain();
            masterGain.gain.value = parseFloat(document.getElementById('param-vol').value);

            shaper = audioCtx.createWaveShaper();
            shaper.curve = makeDistortionCurve(parseFloat(document.getElementById('param-drive').value));
            shaper.oversample = '4x';

            analyser = audioCtx.createAnalyser();
            analyser.fftSize = 2048;

            gainMain = audioCtx.createGain();
            gainMain.gain.value = 0.5;

            gainSub1 = audioCtx.createGain();
            gainSub1.gain.value = parseFloat(document.getElementById('param-sub1').value);

            gainSub2 = audioCtx.createGain();
            gainSub2.gain.value = parseFloat(document.getElementById('param-sub2').value);

            const merger = audioCtx.createChannelMerger(2);
            const pannerL = audioCtx.createStereoPanner();
            pannerL.pan.value = -1.0;
            const pannerR = audioCtx.createStereoPanner();
            pannerR.pan.value = 1.0;

            const f0 = parseFloat(document.getElementById('param-f0').value);
            const delta = parseFloat(document.getElementById('param-delta').value);

            oscL = audioCtx.createOscillator();
            oscL.type = 'sine';
            oscL.frequency.value = f0 - delta / 2;

            oscR = audioCtx.createOscillator();
            oscR.type = 'sine';
            oscR.frequency.value = f0 + delta / 2;

            oscSub1L = audioCtx.createOscillator();
            oscSub1L.type = 'triangle';
            oscSub1L.frequency.value = (f0 / 2) - delta / 4;

            oscSub1R = audioCtx.createOscillator();
            oscSub1R.type = 'triangle';
            oscSub1R.frequency.value = (f0 / 2) + delta / 4;

            oscSub2 = audioCtx.createOscillator();
            oscSub2.type = 'sine';
            oscSub2.frequency.value = f0 / 4;

            oscL.connect(pannerL);
            oscR.connect(pannerR);
            pannerL.connect(gainMain);
            pannerR.connect(gainMain);

            oscSub1L.connect(gainSub1);
            oscSub1R.connect(gainSub1);
            oscSub2.connect(gainSub2);

            gainMain.connect(shaper);
            gainSub1.connect(shaper);
            gainSub2.connect(shaper);

            shaper.connect(masterGain);
            masterGain.connect(analyser);
            analyser.connect(audioCtx.destination);

            oscL.start();
            oscR.start();
            oscSub1L.start();
            oscSub1R.start();
            oscSub2.start();

            drawVisualizer();
        }

        function updateParams() {
            if (!audioCtx) return;
            const f0 = parseFloat(document.getElementById('param-f0').value);
            const delta = parseFloat(document.getElementById('param-delta').value);
            const sub1 = parseFloat(document.getElementById('param-sub1').value);
            const sub2 = parseFloat(document.getElementById('param-sub2').value);
            const drive = parseFloat(document.getElementById('param-drive').value);
            const vol = parseFloat(document.getElementById('param-vol').value);

            document.getElementById('val-f0').textContent = f0.toFixed(1) + ' Hz';
            document.getElementById('val-delta').textContent = delta.toFixed(2) + ' Hz';
            document.getElementById('val-sub1').textContent = sub1.toFixed(2);
            document.getElementById('val-sub2').textContent = sub2.toFixed(2);
            document.getElementById('val-drive').textContent = drive.toFixed(1) + 'x';
            document.getElementById('val-vol').textContent = vol.toFixed(2);

            if (isPlaying) {
                oscL.frequency.setTargetAtTime(f0 - delta / 2, audioCtx.currentTime, 0.05);
                oscR.frequency.setTargetAtTime(f0 + delta / 2, audioCtx.currentTime, 0.05);
                oscSub1L.frequency.setTargetAtTime((f0 / 2) - delta / 4, audioCtx.currentTime, 0.05);
                oscSub1R.frequency.setTargetAtTime((f0 / 2) + delta / 4, audioCtx.currentTime, 0.05);
                oscSub2.frequency.setTargetAtTime(f0 / 4, audioCtx.currentTime, 0.05);

                gainSub1.gain.setTargetAtTime(sub1, audioCtx.currentTime, 0.05);
                gainSub2.gain.setTargetAtTime(sub2, audioCtx.currentTime, 0.05);
                masterGain.gain.setTargetAtTime(vol, audioCtx.currentTime, 0.05);
                shaper.curve = makeDistortionCurve(drive);

                document.getElementById('status-info').textContent = `Active | f₀: ${f0}Hz | L: ${(f0-delta/2).toFixed(2)}Hz | R: ${(f0+delta/2).toFixed(2)}Hz | Sub1: ${(f0/2).toFixed(2)}Hz | Sub2: ${(f0/4).toFixed(2)}Hz`;
            }
        }

        ['param-f0', 'param-delta', 'param-sub1', 'param-sub2', 'param-drive', 'param-vol'].forEach(id => {
            document.getElementById(id).addEventListener('input', updateParams);
        });

        const toggleBtn = document.getElementById('btn-toggle');
        toggleBtn.addEventListener('click', () => {
            if (!isPlaying) {
                if (!audioCtx) initAudio();
                else if (audioCtx.state === 'suspended') audioCtx.resume();
                isPlaying = true;
                toggleBtn.textContent = '⏹ Stop Resonator';
                toggleBtn.classList.remove('btn-primary');
                toggleBtn.classList.add('btn-secondary');
                updateParams();
            } else {
                if (audioCtx) audioCtx.suspend();
                isPlaying = false;
                toggleBtn.textContent = '▶ Start Resonator';
                toggleBtn.classList.remove('btn-secondary');
                toggleBtn.classList.add('btn-primary');
                document.getElementById('status-info').textContent = 'Audio Engine: Paused';
            }
        });

        function applyPreset(f0, delta, sub1, sub2, drive) {
            document.getElementById('param-f0').value = f0;
            document.getElementById('param-delta').value = delta;
            document.getElementById('param-sub1').value = sub1;
            document.getElementById('param-sub2').value = sub2;
            document.getElementById('param-drive').value = drive;
            updateParams();
        }

        function drawVisualizer() {
            const canvas = document.getElementById('scopeCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            function render() {
                animationId = requestAnimationFrame(render);
                analyser.getByteTimeDomainData(dataArray);

                ctx.fillStyle = '#060911';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.lineWidth = 2;
                ctx.strokeStyle = '#00f0ff';
                ctx.beginPath();

                const sliceWidth = canvas.width * 1.0 / bufferLength;
                let x = 0;

                for (let i = 0; i < bufferLength; i++) {
                    const v = dataArray[i] / 128.0;
                    const y = v * canvas.height / 2;

                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);

                    x += sliceWidth;
                }

                ctx.lineTo(canvas.width, canvas.height / 2);
                ctx.stroke();
            }
            render();
        }
    
</script>
