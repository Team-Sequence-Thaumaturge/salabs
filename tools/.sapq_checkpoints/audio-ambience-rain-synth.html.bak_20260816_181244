<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>Audio Procedural Rain Ambience Synth - Quanxs SA Labs</title><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Audio Procedural Rain Ambience Synth","url":"https://salabs.quanxs.com/tools/audio-ambience-rain-synth.html"}</script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9108438313531011" crossorigin="anonymous"></script><style>body{font-family:sans-serif;background:#0f172a;color:#f8fafc;padding:2rem;}.container{max-width:1000px;margin:0 auto;background:#1e293b;padding:2rem;border-radius:12px;text-align:center;}button{background:#38bdf8;color:#0f172a;border:none;padding:0.8rem 1.5rem;border-radius:6px;font-weight:bold;cursor:pointer;}input[type="range"]{width:80%;margin:1rem 0;}</style></head><body><header><h1 style="color:#38bdf8;text-align:center;">Audio Procedural Rain Ambience Synth</h1></header><main class="container"><button id="play-btn" onclick="toggleRain()">Start Rain Audio</button><p>Rain Intensity Level (<span id="rain-val">0.5</span>)</p><input type="range" id="rain-slider" min="0" max="1" step="0.05" value="0.5" oninput="updateVolume()"></main><script>let audioCtx,noiseNode,gainNode,isPlaying=false;function toggleRain(){let btn=document.getElementById('play-btn');if(!isPlaying){audioCtx=new(window.AudioContext||window.webkitAudioContext)();let bSize=audioCtx.sampleRate*2;let nBuf=audioCtx.createBuffer(1,bSize,audioCtx.sampleRate);let out=nBuf.getChannelData(0);for(let i=0;i<bSize;i++)out[i]=Math.random()*2-1;noiseNode=audioCtx.createBufferSource();noiseNode.buffer=nBuf;noiseNode.loop=true;let flt=audioCtx.createBiquadFilter();flt.type='lowpass';flt.frequency.value=1000;gainNode=audioCtx.createGain();gainNode.gain.value=parseFloat(document.getElementById('rain-slider').value);noiseNode.connect(flt);flt.connect(gainNode);gainNode.connect(audioCtx.destination);noiseNode.start();isPlaying=true;btn.innerText='Stop Rain Audio';}else{noiseNode.stop();isPlaying=false;btn.innerText='Start Rain Audio';}}function updateVolume(){let v=document.getElementById('rain-slider').value;document.getElementById('rain-val').innerText=v;if(gainNode)gainNode.gain.value=parseFloat(v);}</script></body></html>