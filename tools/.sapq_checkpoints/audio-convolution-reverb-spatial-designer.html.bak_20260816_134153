<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Convolution Reverb & Spatial IR Studio | Quanxs SA Labs</title>
  <meta name="description" content="Real-time Web Audio API Convolution Reverb and Synthetic Impulse Response (IR) Designer. Design room acoustics, decay, early reflections, and spatial damping 100% in browser.">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9108438313531011" crossorigin="anonymous"></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convolution Reverb & Spatial IR Studio",
    "url": "https://salabs.quanxs.com/tools/audio-convolution-reverb-spatial-designer.html",
    "description": "Real-time Web Audio API Convolution Reverb and Synthetic Impulse Response (IR) Designer.",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0" }
  }
  </script>
  <style>
    :root { --bg: #0d1117; --panel: #161b22; --border: #30363d; --accent: #58a6ff; --text: #c9d1d9; --text-dim: #8b949e; --success: #3fb950; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 20px; line-height: 1.5; }
    .container { max-width: 900px; margin: 0 auto; }
    header { margin-bottom: 24px; text-align: center; border-bottom: 1px solid var(--border); padding-bottom: 16px; }
    h1 { color: var(--accent); font-size: 1.8rem; margin-bottom: 8px; }
    p.subtitle { color: var(--text-dim); font-size: 0.95rem; }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 20px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 600px) { .grid-2 { grid-template-columns: 1fr; } }
    .control-group { margin-bottom: 14px; }
    label { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-dim); margin-bottom: 4px; }
    input[type="range"] { width: 100%; accent-color: var(--accent); }
    select, button { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: #21262d; color: var(--text); font-size: 0.9rem; cursor: pointer; transition: 0.2s; }
    button:hover { background: #30363d; border-color: var(--accent); }
    button.primary { background: #238636; color: white; border: none; font-weight: bold; }
    button.primary:hover { background: #2ea043; }
    canvas { width: 100%; height: 140px; background: #000; border-radius: 6px; border: 1px solid var(--border); display: block; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; background: #238636; color: white; margin-left: 8px; }
  </style>
<script>

    let audioCtx = null;
    let irBuffer = null;

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    function generateSyntheticIR(duration, damping, density, spread) {
      initAudio();
      const sampleRate = audioCtx.sampleRate;
      const length = Math.floor(sampleRate * duration);
      const buffer = audioCtx.createBuffer(2, length, sampleRate);
      const left = buffer.getChannelData(0);
      const right = buffer.getChannelData(1);

      for (let i = 0; i < length; i++) {
        const t = i / length;
        const env = Math.pow(1 - t, damping * 4 + 0.5);
        const noiseL = (Math.random() * 2 - 1) * env;
        const noiseR = (Math.random() * 2 - 1) * env;
        left[i] = noiseL * density + (1 - spread) * noiseR;
        right[i] = noiseR * density + (1 - spread) * noiseL;
      }
      return buffer;
    }

    function drawWaveform(buffer) {
      const canvas = document.getElementById('irCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.clientWidth * window.devicePixelRatio;
      canvas.height = canvas.clientHeight * window.devicePixelRatio;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = '#58a6ff';
      ctx.lineWidth = 1.5;
      ctx.beginPath();

      const data = buffer.getChannelData(0);
      const step = Math.ceil(data.length / canvas.width);
      const amp = canvas.height / 2;

      for (let i = 0; i < canvas.width; i++) {
        let min = 1.0, max = -1.0;
        for (let j = 0; j < step; j++) {
          const datum = data[i * step + j] || 0;
          if (datum < min) min = datum;
          if (datum > max) max = datum;
        }
        ctx.moveTo(i, (1 + min) * amp);
        ctx.lineTo(i, (1 + max) * amp);
      }
      ctx.stroke();
    }

    function updateIR() {
      const decay = parseFloat(document.getElementById('decayTime').value);
      const damping = parseFloat(document.getElementById('damping').value);
      const density = parseFloat(document.getElementById('density').value);
      const spread = parseFloat(document.getElementById('stereoSpread').value);

      document.getElementById('decayVal').textContent = decay.toFixed(1) + 's';
      document.getElementById('dampVal').textContent = damping.toFixed(2);
      document.getElementById('densityVal').textContent = density.toFixed(2);
      document.getElementById('spreadVal').textContent = spread.toFixed(2);

      irBuffer = generateSyntheticIR(decay, damping, density, spread);
      drawWaveform(irBuffer);
    }

    ['decayTime', 'damping', 'density', 'stereoSpread'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateIR);
    });

    document.getElementById('presetSelect').addEventListener('change', (e) => {
      const p = e.target.value;
      if (p === 'concert-hall') { setParams(3.2, 0.45, 0.8, 0.85); }
      else if (p === 'cathedral') { setParams(6.5, 0.25, 0.95, 0.95); }
      else if (p === 'cave') { setParams(4.8, 0.65, 0.7, 0.6); }
      else if (p === 'plate') { setParams(1.8, 0.2, 0.9, 0.7); }
      else if (p === 'vocal-booth') { setParams(0.4, 0.85, 0.5, 0.3); }
      updateIR();
    });

    function setParams(decay, damping, density, spread) {
      document.getElementById('decayTime').value = decay;
      document.getElementById('damping').value = damping;
      document.getElementById('density').value = density;
      document.getElementById('stereoSpread').value = spread;
    }

    document.getElementById('playBtn').addEventListener('click', () => {
      initAudio();
      if (!irBuffer) updateIR();

      const srcType = document.getElementById('sourceSelect').value;
      const convolver = audioCtx.createConvolver();
      convolver.buffer = irBuffer;

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      if (srcType === 'chirp') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(800, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(120, audioCtx.currentTime + 0.3);
      } else if (srcType === 'snare') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(220, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + 0.15);
      } else {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        osc.frequency.setValueAtTime(660, audioCtx.currentTime + 0.1);
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.2);
      }

      gain.gain.setValueAtTime(0.7, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);

      osc.connect(gain);
      gain.connect(convolver);
      convolver.connect(audioCtx.destination);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.4);
    });

    window.addEventListener('load', () => {
      initAudio();
      updateIR();
    });
  
</script>
</head>
<body>
  <div class="container">
    <header>
      <h1>Convolution Reverb & Spatial IR Studio <span class="badge">Pure JS</span></h1>
      <p class="subtitle">Design, synthesize, and preview mathematical impulse responses for realistic 3D acoustic spaces.</p>
    </header>

    <div class="panel">
      <canvas id="irCanvas"></canvas>
    </div>

    <div class="panel">
      <div class="grid-2">
        <div class="control-group">
          <label>Acoustic Preset</label>
          <select id="presetSelect">
            <option value="concert-hall">Concert Hall (Large, Rich Decay)</option>
            <option value="cathedral">Gothic Cathedral (Huge, Dense Tail)</option>
            <option value="cave">Subterranean Cave (High Reflection)</option>
            <option value="plate">Vintage Plate Reverb (Bright, Metallic)</option>
            <option value="vocal-booth">Dry Vocal Booth (Tight, Warm)</option>
          </select>
        </div>
        <div class="control-group">
          <label>Audio Source Signal</label>
          <select id="sourceSelect">
            <option value="chirp">Synthetic Harmonic Chirp</option>
            <option value="snare">Synthesized Snare Impulse</option>
            <option value="melody">Arpeggio Synth Tone</option>
          </select>
        </div>
      </div>

      <div class="grid-2">
        <div class="control-group">
          <label><span>Decay Time (seconds)</span><span id="decayVal">2.5s</span></label>
          <input type="range" id="decayTime" min="0.1" max="8.0" step="0.1" value="2.5">
        </div>
        <div class="control-group">
          <label><span>High-Frequency Damping</span><span id="dampVal">0.50</span></label>
          <input type="range" id="damping" min="0.0" max="1.0" step="0.01" value="0.5">
        </div>
        <div class="control-group">
          <label><span>Early Reflection Density</span><span id="densityVal">0.75</span></label>
          <input type="range" id="density" min="0.1" max="1.0" step="0.05" value="0.75">
        </div>
        <div class="control-group">
          <label><span>Stereo Diffusion Spread</span><span id="spreadVal">0.80</span></label>
          <input type="range" id="stereoSpread" min="0.0" max="1.0" step="0.05" value="0.8">
        </div>
      </div>

      <div class="grid-2" style="margin-top: 10px;">
        <button id="playBtn" class="primary">▶ Play Convolved Audio</button>
        <button id="exportBtn">Download Impulse Response (WAV)</button>
      </div>
    </div>
  </div>

  
</body>
</html>